{
    "root": true,
    "env": {
        "browser": true,
        "es2020": true
    },
    "extends": [
        "eslint:recommended",
        "plugin:@typescript-eslint/recommended"
    ],
    "ignorePatterns": [
        "dist",
        ".eslintrc.json"
    ],
    "parser": "@typescript-eslint/parser",
    "plugins": ["react-hooks"],
    "rules": {
        "@typescript-eslint/no-unused-vars": "warn",
        "no-empty": "warn",
        "no-useless-escape": "warn",
        "@typescript-eslint/no-explicit-any": "warn"
    }
}